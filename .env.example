# Laissez vide pour appeler /api sur la même origine (proxy nginx en Docker, proxy Vite en dev).
# Ne renseignez une URL absolue que si l'API est publiée sur un autre domaine (CORS requis côté API).
# Jamais de secret dans une variable VITE_* : elle est publique dans le bundle.
VITE_API_BASE_URL=

# Adresse de l'API vue depuis le conteneur nginx (réseau Docker commun avec le backend).
API_UPSTREAM=http://api:8080

# Cible du proxy /api du serveur de développement (npm run dev).
DEV_API_PROXY=http://localhost:8080

# Port hôte exposé par Docker Compose.
FRONTEND_PORT=8081